# Never serve the secret runtime config (form-intake key / SMTP pass) or the
# form-intake client library. Deny-only — this subdir inherits digaball's PHP
# handler from the parent config; do not redeclare it here.
<Files ~ "^config.*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
<FilesMatch "^formdata-client\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
